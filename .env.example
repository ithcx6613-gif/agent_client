# ============================================================
# micro-agent - Demo Project Configuration
#
# 复制此文件为 .env 并填写你的实际值
# 运行 scripts/init_new_account.sh 可以自动创建大多数值
# ============================================================

# ============================================================
# Azure AD (Entra ID) Configuration
# ============================================================
TENANT_ID=9188040d-6c67-4c5b-b112-36a304b66dad

# Agent Client App Registration (用户登录使用)
CLIENT_ID=your-client-app-id-here
CLIENT_SECRET=your-client-app-secret-here

# MCP Server App Registration (OBO token 交换使用)
MCP_SERVER_CLIENT_ID=your-mcp-server-app-id-here
MCP_SERVER_CLIENT_SECRET=your-mcp-server-app-secret-here

# ============================================================
# Azure AI Foundry 项目配置
# ============================================================
FOUNDRY_ACCOUNT_NAME=your-foundry-account-name
FOUNDRY_PROJECT_NAME=your-project-name
FOUNDRY_RESOURCE_GROUP=your-resource-group

# ============================================================
# Agent 配置
# ============================================================
AGENT_IDENTITY_BLUEPRINT_ID=your-blueprint-id-here
AGENT_NAME=your-agent-name
AGENT_VERSION=latest

# ============================================================
# MCP Server 配置
# ============================================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# MCP 传输方式: sse (HTTP/SSE) 或 stdio
MCP_TRANSPORT=sse

# Agent Client 回调地址 (OAuth 登录后跳转)
REDIRECT_URI=http://localhost:5000/callback

# 授权范围 (通常不需要修改)
SCOPE=https://ai.azure.com/.default

# ============================================================
# Vault 配置（由 Phase 7 自动填充）
# ============================================================
VAULT_NAME=
VAULT_CONNECTION_NAME=
GITHUB_PAT_SECRET_NAME=github-pat
